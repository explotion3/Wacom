# Unreal generated files
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# IDE and local user files
.vs/
.idea/
Docs/.obsidian/
*.sln
*.suo
*.user
*.userosscache
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# Build artifacts
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
*.app

# Logs and temp files
*.log
*.tmp
*.temp

# Local code intelligence indexes
.codegraph/

# Local planning artifacts
specs/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Unreal local config
*.xcworkspace
*.xcodeproj

# Project content policy
# Keep only project-owned Wacom assets versioned. Ignore other Content assets
# by default so large marketplace/reference imports do not enter source control.
Content/*
!Content/Wacom/
!Content/Wacom/**

# Version every DreamShader-generated asset. UE binaries use Git LFS via .gitattributes.
!Content/DreamMaterials/
!Content/DreamMaterials/**

# Keep project source, config, Wacom content, plugins, and docs versioned.

# Git LFS hooks on Windows redirect to "/dev/null", which Git Bash resolves as a
# literal repo-relative path and creates as ./dev/null/. It is a tooling
# artifact of worktree/checkout operations, never project content.
/dev/
