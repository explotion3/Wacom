import "Shared/DaniloWarp.dsh";

Shader(Name="DreamMaterials/M_DaniloWarp")
{
    Properties = {
        VectorParameter Resolution = float4(1920.0, 1080.0, 0.0, 0.0) [
            Group="DaniloWarp";
            SortPriority=0;
            Description="Viewport resolution for aspect ratio.";
        ];

        ScalarParameter TimeScale = 1.0 [
            Group="Animation";
            SortPriority=5;
            Description="Global time multiplier.";
        ];

        ScalarParameter WarpSpeed = 0.07 [
            Group="Warp";
            SortPriority=10;
            Description="Color channel separation speed. Controls chromatic offset per channel. Try 0.03~0.15.";
        ];

        ScalarParameter WarpStrength = 1.0 [
            Group="Warp";
            SortPriority=15;
            Description="Intensity of the radial warp distortion. Try 0.3~3.0.";
        ];

        ScalarParameter WaveFreq = 9.0 [
            Group="Warp";
            SortPriority=20;
            Description="Frequency of the concentric wave rings. Try 3~20.";
        ];

        ScalarParameter DotSize = 0.01 [
            Group="Dots";
            SortPriority=30;
            Description="Size/brightness of the grid dots. Try 0.005~0.03.";
        ];

        ScalarParameter FinalBrightness = 1.0 [
            Group="Color";
            SortPriority=40;
            Description="Final output brightness multiplier.";
        ];
    }

    Settings = {
        Domain = "UI";
        ShadingModel = "Unlit";
    }

    Outputs = {
        float3 Color;
        Base.EmissiveColor = Color;
        Base.Opacity = 1.0;
    }

    Graph = {
        float2 uv = UE.TexCoord(Index=0);
        float time = UE.Time() * TimeScale;

        float3 warpColor;
        DaniloWarp_Evaluate(uv, Resolution, time, WarpSpeed, WarpStrength, WaveFreq, DotSize, 0.0, warpColor);

        Color = warpColor * FinalBrightness;
    }
}
