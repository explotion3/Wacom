import "Shared/Singularity.dsh";

Shader(Name="DreamMaterials/M_Singularity")
{
    Properties = {
        VectorParameter Resolution = float4(1920.0, 1080.0, 0.0, 0.0) [
            Group="Singularity";
            SortPriority=0;
            Description="Viewport resolution for aspect ratio.";
        ];

        ScalarParameter TimeScale = 1.0 [
            Group="Animation";
            SortPriority=5;
            Description="Global time multiplier.";
        ];

        ScalarParameter Zoom = 0.7 [
            Group="Camera";
            SortPriority=10;
            Description="Zoom level. Lower=zoomed in. Try 0.4~1.5.";
        ];

        ScalarParameter SpiralSpeed = 0.2 [
            Group="Spiral";
            SortPriority=20;
            Description="Rotation speed of the spiral arms. Try 0.1~0.5.";
        ];

        ScalarParameter WaveIterations = 9.0 [
            Group="Spiral";
            SortPriority=25;
            Description="Wave detail iterations (integer). More=richer detail. 4~9.";
        ];

        ScalarParameter WaveDistort = 0.7 [
            Group="Spiral";
            SortPriority=30;
            Description="Wave distortion amount. Try 0.3~1.2.";
        ];

        ScalarParameter DiskSize = 1.0 [
            Group="Disk";
            SortPriority=35;
            Description="Accretion disk size multiplier. Try 0.5~2.0.";
        ];

        ScalarParameter DiskBrightness = 2.0 [
            Group="Disk";
            SortPriority=40;
            Description="Accretion disk brightness base. Lower=brighter disk. Try 1.0~4.0.";
        ];

        ScalarParameter RimRadius = 0.7 [
            Group="Rim";
            SortPriority=45;
            Description="Radius of the bright rim ring. Try 0.4~1.2.";
        ];

        ScalarParameter RimSharpness = 0.03 [
            Group="Rim";
            SortPriority=50;
            Description="Rim edge sharpness. Lower=sharper. Try 0.01~0.1.";
        ];

        ScalarParameter ColorRedBlue = 1.0 [
            Group="Color";
            SortPriority=55;
            Description="Red/blue color gradient intensity. Try 0.5~2.0.";
        ];

        ScalarParameter FinalBrightness = 1.0 [
            Group="Color";
            SortPriority=60;
            Description="Final output brightness multiplier.";
        ];
    }

    Settings = {
        Domain = "UI";
        ShadingModel = "Unlit";
    }

    Outputs = {
        float3 Color;
        Base.EmissiveColor = Color;
        Base.Opacity = 1.0;
    }

    Graph = {
        float2 uv = UE.TexCoord(Index=0);
        float time = UE.Time() * TimeScale;

        float3 bhColor;
        Singularity_Evaluate(uv, Resolution, time, Zoom, SpiralSpeed, WaveIterations, WaveDistort, DiskSize, DiskBrightness, RimRadius, RimSharpness, ColorRedBlue, bhColor);

        Color = bhColor * FinalBrightness;
    }
}
