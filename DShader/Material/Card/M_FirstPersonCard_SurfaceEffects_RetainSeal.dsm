import "Shared/WacomFirstPersonCardSurface.dsh";
import "Shared/WacomFirstPersonCardRetainSeal.dsh";

Shader(Name="DreamMaterials/Card/M_FirstPersonCard_SurfaceEffects_RetainSeal")
{
    Properties = {
        TextureSampleParameter2D Texture = Path(Engine, "/EngineResources/DefaultTexture") [ Group="第一人称保留封存|Retainer"; SortPriority=0; SamplerType="Color"; SamplerSource="FromTextureAsset"; ];

        ScalarParameter TiltX = 0.0 [ Group="第一人称保留封存|运行时"; SortPriority=10; ];
        ScalarParameter TiltY = 0.0 [ Group="第一人称保留封存|运行时"; SortPriority=11; ];
        ScalarParameter PerspectiveStrength = 0.12 [ Group="第一人称保留封存|运行时"; SortPriority=12; ];
        ScalarParameter ContactShadowEnabled = 1.0 [ Group="第一人称保留封存|运行时"; SortPriority=13; ];
        ScalarParameter ContactShadowLift = 0.0 [ Group="第一人称保留封存|运行时"; SortPriority=14; ];
        ScalarParameter ContactShadowTiltOffsetXUV = 0.0 [ Group="第一人称保留封存|运行时"; SortPriority=15; ];
        ScalarParameter ContactShadowTiltOffsetYUV = 0.0 [ Group="第一人称保留封存|运行时"; SortPriority=16; ];
        ScalarParameter ContactShadowOpacityMultiplier = 1.0 [ Group="第一人称保留封存|运行时"; SortPriority=17; ];
        ScalarParameter RetainSealEnabled = 0.0 [ Group="第一人称保留封存|运行时"; SortPriority=20; ];
        ScalarParameter RetainSealPhase = 0.0 [ Group="第一人称保留封存|运行时"; SortPriority=21; ];
        ScalarParameter RetainSealProgress = 0.0 [ Group="第一人称保留封存|运行时"; SortPriority=22; ];
        ScalarParameter RetainSealSeed = 0.0 [ Group="第一人称保留封存|运行时"; SortPriority=23; ];
        ScalarParameter RetainSealReducedMotion = 0.0 [ Group="第一人称保留封存|运行时"; SortPriority=24; ];
        VectorParameter SurfaceInvSize = float4(0.002193, 0.001923, 0.0, 0.0) [ Group="第一人称保留封存|运行时"; SortPriority=25; ];

        ScalarParameter RetainSealPixelColumns = 96.0 [ Group="第一人称保留封存|材质实例"; SortPriority=40; ];
        ScalarParameter RetainSealCornerExtent = 0.14 [ Group="第一人称保留封存|材质实例"; SortPriority=41; ];
        ScalarParameter RetainSealCornerThickness = 0.025 [ Group="第一人称保留封存|材质实例"; SortPriority=42; ];
        ScalarParameter RetainSealOuterEdgeWidth = 0.010 [ Group="第一人称保留封存|材质实例"; SortPriority=43; ];
        ScalarParameter RetainSealCenterStampExtent = 0.045 [ Group="第一人称保留封存|材质实例"; SortPriority=44; ];
        ScalarParameter RetainSealHeldIntensity = 0.25 [ Group="第一人称保留封存|材质实例"; SortPriority=45; ];
        ScalarParameter RetainSealBrightness = 1.35 [ Group="第一人称保留封存|材质实例"; SortPriority=46; ];
        VectorParameter RetainSealPrimaryColor = float4(0.96, 0.82, 0.42, 1.0) [ Group="第一人称保留封存|材质实例"; SortPriority=47; ];
        VectorParameter RetainSealSecondaryColor = float4(0.58, 0.80, 1.0, 1.0) [ Group="第一人称保留封存|材质实例"; SortPriority=48; ];

        ScalarParameter ReferenceTiltDegrees = 9.0 [ Group="第一人称保留封存|投影制作"; SortPriority=60; ];
        ScalarParameter ForeshortenStrength = 0.025 [ Group="第一人称保留封存|投影制作"; SortPriority=61; ];
        ScalarParameter EdgeFadeUV = 0.0025 [ Group="第一人称保留封存|投影制作"; SortPriority=62; ];
        VectorParameter ContactShadowColor = float4(0.008, 0.006, 0.004, 1.0) [ Group="第一人称保留封存|阴影制作"; SortPriority=70; ];
        ScalarParameter ContactShadowBaseOffsetXUV = 0.0 [ Group="第一人称保留封存|阴影制作"; SortPriority=71; ];
        ScalarParameter ContactShadowBaseOffsetYUV = 0.0039 [ Group="第一人称保留封存|阴影制作"; SortPriority=72; ];
        ScalarParameter ContactShadowLiftOffsetXUV = 0.0 [ Group="第一人称保留封存|阴影制作"; SortPriority=73; ];
        ScalarParameter ContactShadowLiftOffsetYUV = 0.0100 [ Group="第一人称保留封存|阴影制作"; SortPriority=74; ];
        ScalarParameter ContactShadowBaseSoftnessUV = 0.0025 [ Group="第一人称保留封存|阴影制作"; SortPriority=75; ];
        ScalarParameter ContactShadowLiftSoftnessUV = 0.0065 [ Group="第一人称保留封存|阴影制作"; SortPriority=76; ];
        ScalarParameter ContactShadowBaseOpacity = 0.22 [ Group="第一人称保留封存|阴影制作"; SortPriority=77; ];
        ScalarParameter ContactShadowLiftOpacity = 0.09 [ Group="第一人称保留封存|阴影制作"; SortPriority=78; ];
        ScalarParameter ContactShadowAlphaThreshold = 0.18 [ Group="第一人称保留封存|阴影制作"; SortPriority=79; ];
        ScalarParameter ContactShadowAlphaFeather = 0.12 [ Group="第一人称保留封存|阴影制作"; SortPriority=80; ];
    }

    Settings = { Domain = "UI"; ShadingModel = "Unlit"; BlendMode = "PremultipliedAlpha"; TwoSided = true; }
    Outputs = { float3 Color; float Alpha; Base.EmissiveColor = Color; Base.Opacity = Alpha; }

    Graph = {
        float2 uv = UE.TexCoord(Index=0);
        float3 projectedUVAndMask;
        WacomFirstPersonCard_ProjectSurface(uv, TiltX, TiltY, PerspectiveStrength, ReferenceTiltDegrees, ForeshortenStrength, EdgeFadeUV, projectedUVAndMask);
        float2 projectedUV = UE.Expression(Class="ComponentMask", OutputType="float2", Input=projectedUVAndMask, R=true,G=true,B=false,A=false);
        float insideMask = UE.Expression(Class="ComponentMask", OutputType="float1", Input=projectedUVAndMask, R=false,G=false,B=true,A=false);
        float4 surface = Texture(Coordinates=projectedUV);
        float3 surfaceColor = UE.Expression(Class="ComponentMask", OutputType="float3", Input=surface, R=true,G=true,B=true,A=false);
        float surfaceAlpha = UE.Expression(Class="ComponentMask", OutputType="float1", Input=surface, R=false,G=false,B=false,A=true);

        float cornerMask; float edgeMask; float centerStampMask; float paletteVariant;
        WacomFirstPersonCard_ComputeRetainSeal(projectedUV, RetainSealPhase, RetainSealProgress, RetainSealReducedMotion, RetainSealPixelColumns, RetainSealCornerExtent, RetainSealCornerThickness, RetainSealOuterEdgeWidth, RetainSealCenterStampExtent, RetainSealHeldIntensity, RetainSealSeed, cornerMask, edgeMask, centerStampMask, paletteVariant);
        float3 primaryColor = UE.Expression(Class="ComponentMask", OutputType="float3", Input=RetainSealPrimaryColor, R=true,G=true,B=true,A=false);
        float3 secondaryColor = UE.Expression(Class="ComponentMask", OutputType="float3", Input=RetainSealSecondaryColor, R=true,G=true,B=true,A=false);
        float3 sealColor;
        WacomFirstPersonCard_SelectRetainSealColor(paletteVariant, primaryColor, secondaryColor, sealColor);
        float sealAlpha = saturate(cornerMask + edgeMask * 0.55 + centerStampMask) * saturate(RetainSealEnabled) * surfaceAlpha * insideMask;

        float safeLift = clamp(ContactShadowLift, 0.0, 1.0);
        float2 shadowOffset;
        WacomFirstPersonCard_ResolveContactShadowOffset(safeLift, ContactShadowBaseOffsetXUV, ContactShadowBaseOffsetYUV, ContactShadowLiftOffsetXUV, ContactShadowLiftOffsetYUV, ContactShadowTiltOffsetXUV, ContactShadowTiltOffsetYUV, shadowOffset);
        float shadowSoftness = lerp(ContactShadowBaseSoftnessUV, ContactShadowLiftSoftnessUV, safeLift);
        float2 shadowUV = projectedUV - shadowOffset;
        float2 sx = float2(shadowSoftness, 0.0); float2 sy = float2(0.0, shadowSoftness);
        float4 c0 = Texture(Coordinates=shadowUV); float4 c1 = Texture(Coordinates=shadowUV-sx); float4 c2 = Texture(Coordinates=shadowUV+sx);
        float4 c3 = Texture(Coordinates=shadowUV-sy); float4 c4 = Texture(Coordinates=shadowUV+sy); float4 c5 = Texture(Coordinates=shadowUV-sx-sy);
        float4 c6 = Texture(Coordinates=shadowUV+sx-sy); float4 c7 = Texture(Coordinates=shadowUV-sx+sy); float4 c8 = Texture(Coordinates=shadowUV+sx+sy);
        float a0 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c0, R=false,G=false,B=false,A=true);
        float a1 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c1, R=false,G=false,B=false,A=true);
        float a2 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c2, R=false,G=false,B=false,A=true);
        float a3 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c3, R=false,G=false,B=false,A=true);
        float a4 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c4, R=false,G=false,B=false,A=true);
        float a5 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c5, R=false,G=false,B=false,A=true);
        float a6 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c6, R=false,G=false,B=false,A=true);
        float a7 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c7, R=false,G=false,B=false,A=true);
        float a8 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c8, R=false,G=false,B=false,A=true);
        float shadowMask;
        WacomFirstPersonCard_CombineContactShadowAlpha(a0,a1,a2,a3,a4,a5,a6,a7,a8,ContactShadowAlphaThreshold,ContactShadowAlphaFeather,shadowMask);
        float3 shadowColor = UE.Expression(Class="ComponentMask", OutputType="float3", Input=ContactShadowColor, R=true,G=true,B=true,A=false);
        float cardAlpha = surfaceAlpha * insideMask;
        float shadowOpacity = lerp(ContactShadowBaseOpacity, ContactShadowLiftOpacity, safeLift) * max(ContactShadowOpacityMultiplier, 0.0);
        float shadowAlpha = shadowMask * shadowOpacity * clamp(ContactShadowEnabled,0.0,1.0) * insideMask * (1.0-cardAlpha);

        Color = surfaceColor * insideMask + sealColor * sealAlpha * max(RetainSealBrightness, 0.0) + shadowColor * shadowAlpha;
        Alpha = saturate(cardAlpha + sealAlpha + shadowAlpha);
    }
}
