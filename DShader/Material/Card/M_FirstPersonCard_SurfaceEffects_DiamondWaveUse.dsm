import "Shared/WacomFirstPersonCardSurface.dsh";
import "Shared/WacomFirstPersonCardUseDiamondWave.dsh";

Shader(Name="DreamMaterials/Card/M_FirstPersonCard_SurfaceEffects_DiamondWaveUse")
{
    Properties = {
        TextureSampleParameter2D Texture = Path(Engine, "/EngineResources/DefaultTexture") [
            Group="第一人称卡牌使用效果|Retainer";
            SortPriority=0;
            Description="RetainerBox 注入的实时卡面；参数名必须保持为 Texture。";
            SamplerType="Color";
            SamplerSource="FromTextureAsset";
        ];

        ScalarParameter TiltX = 0.0 [ Group="第一人称卡牌使用效果|运行时"; SortPriority=10; ];
        ScalarParameter TiltY = 0.0 [ Group="第一人称卡牌使用效果|运行时"; SortPriority=11; ];
        ScalarParameter PerspectiveStrength = 0.12 [ Group="第一人称卡牌使用效果|运行时"; SortPriority=12; ];
        ScalarParameter ContactShadowEnabled = 1.0 [ Group="第一人称卡牌使用效果|运行时"; SortPriority=13; ];
        ScalarParameter ContactShadowLift = 0.0 [ Group="第一人称卡牌使用效果|运行时"; SortPriority=14; ];
        ScalarParameter CardUseEnabled = 0.0 [ Group="第一人称卡牌使用效果|运行时"; SortPriority=20; ];
        ScalarParameter CardUseProgress = 0.0 [ Group="第一人称卡牌使用效果|运行时"; SortPriority=21; ];
        ScalarParameter CardUseTime = 0.0 [ Group="第一人称卡牌使用效果|运行时"; SortPriority=22; ];
        ScalarParameter CardUseReducedMotion = 0.0 [ Group="第一人称卡牌使用效果|运行时"; SortPriority=23; ];
        VectorParameter SurfaceInvSize = float4(0.00277778, 0.00206612, 0.0, 0.0) [ Group="第一人称卡牌使用效果|运行时"; SortPriority=24; ];

        ScalarParameter UseGridColumns = 10.0 [ Group="第一人称卡牌使用效果|材质实例"; SortPriority=30; ];
        ScalarParameter UseRotationDegrees = 45.0 [ Group="第一人称卡牌使用效果|材质实例"; SortPriority=31; ];
        ScalarParameter UseWaveBandCells = 1.5 [ Group="第一人称卡牌使用效果|材质实例"; SortPriority=32; ];
        ScalarParameter UseOutlineWidth = 0.12 [ Group="第一人称卡牌使用效果|材质实例"; SortPriority=33; ];
        ScalarParameter UseOutlineSoftness = 0.025 [ Group="第一人称卡牌使用效果|材质实例"; SortPriority=34; ];
        VectorParameter UsePrimaryColor = float4(0.20, 0.56, 1.0, 1.0) [ Group="第一人称卡牌使用效果|材质实例"; SortPriority=35; ];
        VectorParameter UseAccentColor = float4(1.0, 1.0, 1.0, 1.0) [ Group="第一人称卡牌使用效果|材质实例"; SortPriority=36; ];
        ScalarParameter UseGlowIntensity = 1.35 [ Group="第一人称卡牌使用效果|材质实例"; SortPriority=37; ];
        ScalarParameter UseShadowFadeSeconds = 0.10 [ Group="第一人称卡牌使用效果|材质实例"; SortPriority=38; ];

        ScalarParameter ReferenceTiltDegrees = 9.0 [ Group="第一人称卡牌使用效果|投影制作"; SortPriority=50; ];
        ScalarParameter ForeshortenStrength = 0.025 [ Group="第一人称卡牌使用效果|投影制作"; SortPriority=51; ];
        ScalarParameter EdgeFadeUV = 0.0025 [ Group="第一人称卡牌使用效果|投影制作"; SortPriority=52; ];
        VectorParameter ContactShadowColor = float4(0.008, 0.006, 0.004, 1.0) [ Group="第一人称卡牌使用效果|阴影制作"; SortPriority=60; ];
        ScalarParameter ContactShadowBaseOffsetXUV = 0.0 [ Group="第一人称卡牌使用效果|阴影制作"; SortPriority=61; ];
        ScalarParameter ContactShadowBaseOffsetYUV = 0.0039 [ Group="第一人称卡牌使用效果|阴影制作"; SortPriority=62; ];
        ScalarParameter ContactShadowLiftOffsetXUV = 0.0 [ Group="第一人称卡牌使用效果|阴影制作"; SortPriority=63; ];
        ScalarParameter ContactShadowLiftOffsetYUV = 0.0100 [ Group="第一人称卡牌使用效果|阴影制作"; SortPriority=64; ];
        ScalarParameter ContactShadowBaseSoftnessUV = 0.0025 [ Group="第一人称卡牌使用效果|阴影制作"; SortPriority=65; ];
        ScalarParameter ContactShadowLiftSoftnessUV = 0.0065 [ Group="第一人称卡牌使用效果|阴影制作"; SortPriority=66; ];
        ScalarParameter ContactShadowBaseOpacity = 0.22 [ Group="第一人称卡牌使用效果|阴影制作"; SortPriority=67; ];
        ScalarParameter ContactShadowLiftOpacity = 0.09 [ Group="第一人称卡牌使用效果|阴影制作"; SortPriority=68; ];
        ScalarParameter ContactShadowAlphaThreshold = 0.18 [ Group="第一人称卡牌使用效果|阴影制作"; SortPriority=69; ];
        ScalarParameter ContactShadowAlphaFeather = 0.12 [ Group="第一人称卡牌使用效果|阴影制作"; SortPriority=70; ];
    }

    Settings = {
        Domain = "UI";
        ShadingModel = "Unlit";
        BlendMode = "PremultipliedAlpha";
        TwoSided = true;
    }

    Outputs = {
        float3 Color;
        float Alpha;
        Base.EmissiveColor = Color;
        Base.Opacity = Alpha;
    }

    Graph = {
        float2 uv = UE.TexCoord(Index=0);
        float3 projectedUVAndMask;
        WacomFirstPersonCard_ProjectSurface(
            uv,
            TiltX,
            TiltY,
            PerspectiveStrength,
            ReferenceTiltDegrees,
            ForeshortenStrength,
            EdgeFadeUV,
            projectedUVAndMask);

        float2 projectedUV = UE.Expression(
            Class="ComponentMask", OutputType="float2", Input=projectedUVAndMask,
            R=true, G=true, B=false, A=false);
        float insideMask = UE.Expression(
            Class="ComponentMask", OutputType="float1", Input=projectedUVAndMask,
            R=false, G=false, B=true, A=false);
        float4 surface = Texture(Coordinates=projectedUV);
        float3 surfaceColor = UE.Expression(
            Class="ComponentMask", OutputType="float3", Input=surface,
            R=true, G=true, B=true, A=false);
        float surfaceAlpha = UE.Expression(
            Class="ComponentMask", OutputType="float1", Input=surface,
            R=false, G=false, B=false, A=true);
        float2 surfaceInvSize = UE.Expression(
            Class="ComponentMask", OutputType="float2", Input=SurfaceInvSize,
            R=true, G=true, B=false, A=false);

        float useVisibleMask;
        float useOutlineGlowMask;
        float useFillGlowMask;
        WacomFirstPersonCard_ComputeUseDiamondWave(
            projectedUV,
            surfaceInvSize,
            UseGridColumns,
            UseRotationDegrees,
            UseWaveBandCells,
            UseOutlineWidth,
            UseOutlineSoftness,
            CardUseProgress,
            CardUseReducedMotion,
            useVisibleMask,
            useOutlineGlowMask,
            useFillGlowMask);
        float useEnabled = saturate(CardUseEnabled);
        float cardVisibleMask = lerp(1.0, useVisibleMask, useEnabled);
        float cardAlpha = surfaceAlpha * insideMask * cardVisibleMask;
        float3 cardColor = surfaceColor * insideMask * cardVisibleMask;

        float3 usePrimaryColorRGB = UE.Expression(
            Class="ComponentMask", OutputType="float3", Input=UsePrimaryColor,
            R=true, G=true, B=true, A=false);
        float3 useAccentColorRGB = UE.Expression(
            Class="ComponentMask", OutputType="float3", Input=UseAccentColor,
            R=true, G=true, B=true, A=false);
        float glowMask = saturate(useOutlineGlowMask + useFillGlowMask) * useEnabled;
        float glowAlpha = surfaceAlpha * insideMask * glowMask;
        float3 glowColor = (
            usePrimaryColorRGB * useOutlineGlowMask
            + useAccentColorRGB * useFillGlowMask)
            * max(UseGlowIntensity, 0.0)
            * surfaceAlpha
            * insideMask
            * useEnabled;

        float safeContactShadowLift = clamp(ContactShadowLift, 0.0, 1.0);
        float2 contactShadowOffsetUV = float2(
            lerp(ContactShadowBaseOffsetXUV, ContactShadowLiftOffsetXUV, safeContactShadowLift),
            lerp(ContactShadowBaseOffsetYUV, ContactShadowLiftOffsetYUV, safeContactShadowLift));
        float contactShadowSoftnessUV = lerp(
            ContactShadowBaseSoftnessUV,
            ContactShadowLiftSoftnessUV,
            safeContactShadowLift);
        float2 contactShadowSampleUV = projectedUV - contactShadowOffsetUV;
        float2 contactShadowStepX = float2(contactShadowSoftnessUV, 0.0);
        float2 contactShadowStepY = float2(0.0, contactShadowSoftnessUV);

        float4 contactCenter = Texture(Coordinates=contactShadowSampleUV);
        float4 contactLeft = Texture(Coordinates=contactShadowSampleUV - contactShadowStepX);
        float4 contactRight = Texture(Coordinates=contactShadowSampleUV + contactShadowStepX);
        float4 contactTop = Texture(Coordinates=contactShadowSampleUV - contactShadowStepY);
        float4 contactBottom = Texture(Coordinates=contactShadowSampleUV + contactShadowStepY);
        float4 contactTopLeft = Texture(Coordinates=contactShadowSampleUV - contactShadowStepX - contactShadowStepY);
        float4 contactTopRight = Texture(Coordinates=contactShadowSampleUV + contactShadowStepX - contactShadowStepY);
        float4 contactBottomLeft = Texture(Coordinates=contactShadowSampleUV - contactShadowStepX + contactShadowStepY);
        float4 contactBottomRight = Texture(Coordinates=contactShadowSampleUV + contactShadowStepX + contactShadowStepY);

        float contactCenterAlpha = UE.Expression(Class="ComponentMask", OutputType="float1", Input=contactCenter, R=false, G=false, B=false, A=true);
        float contactLeftAlpha = UE.Expression(Class="ComponentMask", OutputType="float1", Input=contactLeft, R=false, G=false, B=false, A=true);
        float contactRightAlpha = UE.Expression(Class="ComponentMask", OutputType="float1", Input=contactRight, R=false, G=false, B=false, A=true);
        float contactTopAlpha = UE.Expression(Class="ComponentMask", OutputType="float1", Input=contactTop, R=false, G=false, B=false, A=true);
        float contactBottomAlpha = UE.Expression(Class="ComponentMask", OutputType="float1", Input=contactBottom, R=false, G=false, B=false, A=true);
        float contactTopLeftAlpha = UE.Expression(Class="ComponentMask", OutputType="float1", Input=contactTopLeft, R=false, G=false, B=false, A=true);
        float contactTopRightAlpha = UE.Expression(Class="ComponentMask", OutputType="float1", Input=contactTopRight, R=false, G=false, B=false, A=true);
        float contactBottomLeftAlpha = UE.Expression(Class="ComponentMask", OutputType="float1", Input=contactBottomLeft, R=false, G=false, B=false, A=true);
        float contactBottomRightAlpha = UE.Expression(Class="ComponentMask", OutputType="float1", Input=contactBottomRight, R=false, G=false, B=false, A=true);
        float contactShadowMask;
        WacomFirstPersonCard_CombineContactShadowAlpha(
            contactCenterAlpha,
            contactLeftAlpha,
            contactRightAlpha,
            contactTopAlpha,
            contactBottomAlpha,
            contactTopLeftAlpha,
            contactTopRightAlpha,
            contactBottomLeftAlpha,
            contactBottomRightAlpha,
            ContactShadowAlphaThreshold,
            ContactShadowAlphaFeather,
            contactShadowMask);

        float contactCasterVisible;
        float contactOutlineUnused;
        float contactFillUnused;
        WacomFirstPersonCard_ComputeUseDiamondWave(
            contactShadowSampleUV,
            surfaceInvSize,
            UseGridColumns,
            UseRotationDegrees,
            UseWaveBandCells,
            UseOutlineWidth,
            UseOutlineSoftness,
            CardUseProgress,
            CardUseReducedMotion,
            contactCasterVisible,
            contactOutlineUnused,
            contactFillUnused);
        float shadowCasterVisibleMask = lerp(1.0, contactCasterVisible, useEnabled);
        float3 contactShadowColorRGB = UE.Expression(
            Class="ComponentMask", OutputType="float3", Input=ContactShadowColor,
            R=true, G=true, B=true, A=false);
        float contactShadowOpacity = lerp(
            ContactShadowBaseOpacity,
            ContactShadowLiftOpacity,
            safeContactShadowLift);
        float cardUseShadowFade = lerp(
            1.0,
            1.0 - saturate(CardUseTime / max(UseShadowFadeSeconds, 0.001)),
            useEnabled);
        float contactShadowAlpha =
            contactShadowMask
            * shadowCasterVisibleMask
            * contactShadowOpacity
            * clamp(ContactShadowEnabled, 0.0, 1.0)
            * insideMask
            * (1.0 - cardAlpha)
            * cardUseShadowFade;

        Color = cardColor + glowColor + contactShadowColorRGB * contactShadowAlpha;
        Alpha = saturate(cardAlpha + glowAlpha + contactShadowAlpha);
    }
}
