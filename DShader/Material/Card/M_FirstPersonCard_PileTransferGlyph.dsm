        ];
        ScalarParameter GlyphBorderWidth = 0.10 [
            Group="第一人称牌堆迁移|材质实例";
            SortPriority=50;
            Description="卡背描边宽度，使用 UV 单位；默认 0.10，推荐 0.06 到 0.16。";
