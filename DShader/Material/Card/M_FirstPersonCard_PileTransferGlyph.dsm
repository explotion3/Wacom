import "Shared/WacomFirstPersonCardPileTransferGlyph.dsh";

Shader(Name="DreamMaterials/Card/M_FirstPersonCard_PileTransferGlyph")
{
    Properties = {
        VectorParameter GlyphOutlineColor = float4(0.96, 0.82, 0.42, 1.0) [
            Group="第一人称牌堆迁移|材质实例";
            SortPriority=10;
            Description="像素卡背牌印外轮廓颜色和透明度。";
        ];
        VectorParameter GlyphFillColor = float4(0.08, 0.18, 0.32, 0.92) [
            Group="第一人称牌堆迁移|材质实例";
            SortPriority=20;
            Description="像素卡背牌印内部填充颜色和透明度。";
        ];
        VectorParameter GlyphCenterColor = float4(0.58, 0.80, 1.0, 1.0) [
            Group="第一人称牌堆迁移|材质实例";
            SortPriority=30;
            Description="中央菱形方印颜色和透明度。";
        ];
        ScalarParameter GlyphPixelColumns = 14.0 [
            Group="第一人称牌堆迁移|材质实例";
            SortPriority=40;
            Description="横向像素量化列数；默认 14，推荐 10 到 20。";
        ];
        ScalarParameter GlyphBorderWidth = 0.10 [
            Group="第一人称牌堆迁移|材质实例";
            SortPriority=50;
            Description="卡背描边宽度，使用 UV 单位；默认 0.10，推荐 0.06 到 0.16。";
        ];
        ScalarParameter GlyphCenterMarkSize = 0.22 [
            Group="第一人称牌堆迁移|材质实例";
            SortPriority=60;
            Description="中央方印半径，使用 UV 曼哈顿距离；默认 0.22，推荐 0.14 到 0.30。";
        ];
        ScalarParameter GlyphGlowStrength = 0.65 [
            Group="第一人称牌堆迁移|材质实例";
            SortPriority=70;
            Description="描边和中央方印的额外自发光强度；默认 0.65，推荐 0.2 到 1.4。";
        ];
        VectorParameter MotePrimaryColor = float4(0.62, 0.82, 1.0, 1.0) [
            Group="第一人称牌堆迁移|飘散像素";
            SortPriority=80;
            Description="大多数飘散像素的主颜色和透明度。";
        ];
        VectorParameter MoteAccentColor = float4(1.0, 0.82, 0.42, 1.0) [
            Group="第一人称牌堆迁移|飘散像素";
            SortPriority=90;
            Description="少量飘散像素的强调颜色和透明度。";
        ];
        ScalarParameter MoteGlowStrength = 0.55 [
            Group="第一人称牌堆迁移|飘散像素";
            SortPriority=100;
            Description="飘散像素出生阶段的额外亮度；默认 0.55，推荐 0 到 1.2。";
        ];
    }

    Settings = {
        Domain = "UI";
        ShadingModel = "Unlit";
        BlendMode = "PremultipliedAlpha";
        TwoSided = true;
    }

    Outputs = {
        float3 Color;
        float Alpha;
        Base.EmissiveColor = Color;
        Base.Opacity = Alpha;
    }

    Graph = {
        float2 uv = UE.TexCoord(Index=0);
        float2 shapeData = UE.TexCoord(Index=1);
        WacomFirstPersonCard_ComputePileTransferVisual(
            uv,
            shapeData,
            GlyphPixelColumns,
            GlyphBorderWidth,
            GlyphCenterMarkSize,
            GlyphOutlineColor,
            GlyphFillColor,
            GlyphCenterColor,
            GlyphGlowStrength,
            MotePrimaryColor,
            MoteAccentColor,
            MoteGlowStrength,
            Color,
            Alpha);
    }
}
