import "Shared/WacomFirstPersonCardPileTransferGlyph.dsh";

Shader(Name="DreamMaterials/Card/M_FirstPersonCard_PileTransferGlyph")
{
    Properties = {
        VectorParameter GlyphOutlineColor = float4(0.96, 0.82, 0.42, 1.0) [
            Group="第一人称牌堆迁移|材质实例";
            SortPriority=10;
            Description="像素卡背牌印外轮廓颜色和透明度。";
        ];
        VectorParameter GlyphFillColor = float4(0.08, 0.18, 0.32, 0.92) [
            Group="第一人称牌堆迁移|材质实例";
            SortPriority=20;
            Description="像素卡背牌印内部填充颜色和透明度。";
        ];
        VectorParameter GlyphCenterColor = float4(0.58, 0.80, 1.0, 1.0) [
            Group="第一人称牌堆迁移|材质实例";
