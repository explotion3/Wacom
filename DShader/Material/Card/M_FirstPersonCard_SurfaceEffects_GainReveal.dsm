import "Shared/WacomFirstPersonCardSurface.dsh";
import "Shared/WacomFirstPersonCardGainReveal.dsh";

Shader(Name="DreamMaterials/Card/M_FirstPersonCard_SurfaceEffects_GainReveal")
{
    Properties = {
        TextureSampleParameter2D Texture = Path(Engine, "/EngineResources/DefaultTexture") [ Group="第一人称获得结晶|Retainer"; SortPriority=0; SamplerType="Color"; SamplerSource="FromTextureAsset"; ];

        ScalarParameter TiltX = 0.0 [ Group="第一人称获得结晶|运行时"; SortPriority=10; ];
        ScalarParameter TiltY = 0.0 [ Group="第一人称获得结晶|运行时"; SortPriority=11; ];
        ScalarParameter PerspectiveStrength = 0.12 [ Group="第一人称获得结晶|运行时"; SortPriority=12; ];
        ScalarParameter ContactShadowEnabled = 1.0 [ Group="第一人称获得结晶|运行时"; SortPriority=13; ];
        ScalarParameter ContactShadowLift = 0.0 [ Group="第一人称获得结晶|运行时"; SortPriority=14; ];
        ScalarParameter ContactShadowTiltOffsetXUV = 0.0 [ Group="第一人称获得结晶|运行时"; SortPriority=15; ];
        ScalarParameter ContactShadowTiltOffsetYUV = 0.0 [ Group="第一人称获得结晶|运行时"; SortPriority=16; ];
        ScalarParameter ContactShadowOpacityMultiplier = 1.0 [ Group="第一人称获得结晶|运行时"; SortPriority=17; ];
        ScalarParameter GainRevealEnabled = 0.0 [ Group="第一人称获得结晶|运行时"; SortPriority=20; ];
        ScalarParameter GainRevealProgress = 0.0 [ Group="第一人称获得结晶|运行时"; SortPriority=21; ];
        ScalarParameter GainRevealReducedMotion = 0.0 [ Group="第一人称获得结晶|运行时"; SortPriority=22; ];
        ScalarParameter GainRevealSeed = 0.0 [ Group="第一人称获得结晶|运行时"; SortPriority=23; ];
        ScalarParameter GainRevealRarityIndex = 0.0 [ Group="第一人称获得结晶|运行时"; SortPriority=24; ];
        ScalarParameter GainRevealSeedEstablishEnd = 0.12 [ Group="第一人称获得结晶|运行时"; SortPriority=25; ];
        ScalarParameter GainRevealAssemblyEnd = 0.62 [ Group="第一人称获得结晶|运行时"; SortPriority=26; ];
        ScalarParameter GainRevealRarityEdgePeak = 0.70 [ Group="第一人称获得结晶|运行时"; SortPriority=27; ];
        ScalarParameter GainRevealSettleEnd = 0.84 [ Group="第一人称获得结晶|运行时"; SortPriority=28; ];
        ScalarParameter GainRevealReducedCrossFadeStart = 0.25 [ Group="第一人称获得结晶|运行时"; SortPriority=29; ];
        ScalarParameter GainRevealReducedCrossFadeEnd = 0.65 [ Group="第一人称获得结晶|运行时"; SortPriority=30; ];
        VectorParameter SurfaceInvSize = float4(0.002193, 0.001923, 0.0, 0.0) [ Group="第一人称获得结晶|运行时"; SortPriority=31; ];

        ScalarParameter GainRevealPixelColumns = 96.0 [ Group="第一人称获得结晶|材质实例"; SortPriority=40; ];
        ScalarParameter GainRevealClusterDensity = 0.18 [ Group="第一人称获得结晶|材质实例"; SortPriority=41; ];
        ScalarParameter GainRevealClusterTravelPixels = 12.0 [ Group="第一人称获得结晶|材质实例"; SortPriority=42; ];
        ScalarParameter GainRevealCrystalBrightness = 1.25 [ Group="第一人称获得结晶|材质实例"; SortPriority=43; ];
        ScalarParameter GainRevealEdgeBrightness = 1.45 [ Group="第一人称获得结晶|材质实例"; SortPriority=44; ];
        VectorParameter GainRevealCrystalPrimaryColor = float4(0.58, 0.80, 1.0, 1.0) [ Group="第一人称获得结晶|材质实例"; SortPriority=45; ];
        VectorParameter GainRevealCrystalSecondaryColor = float4(0.96, 0.82, 0.42, 1.0) [ Group="第一人称获得结晶|材质实例"; SortPriority=46; ];
        VectorParameter GainRevealNeutralEdgeColor = float4(0.78, 0.82, 0.86, 1.0) [ Group="第一人称获得结晶|材质实例"; SortPriority=47; ];
        VectorParameter GainRevealWhiteEdgeColor = float4(0.98, 0.90, 0.68, 1.0) [ Group="第一人称获得结晶|材质实例"; SortPriority=48; ];
        VectorParameter GainRevealBlueEdgeColor = float4(0.42, 0.82, 1.0, 1.0) [ Group="第一人称获得结晶|材质实例"; SortPriority=49; ];
        VectorParameter GainRevealYellowEdgeColor = float4(1.0, 0.72, 0.20, 1.0) [ Group="第一人称获得结晶|材质实例"; SortPriority=50; ];
        VectorParameter GainRevealPurpleEdgeColor = float4(0.92, 0.34, 0.92, 1.0) [ Group="第一人称获得结晶|材质实例"; SortPriority=51; ];

        ScalarParameter ReferenceTiltDegrees = 9.0 [ Group="第一人称获得结晶|投影制作"; SortPriority=60; ];
        ScalarParameter ForeshortenStrength = 0.025 [ Group="第一人称获得结晶|投影制作"; SortPriority=61; ];
        ScalarParameter EdgeFadeUV = 0.0025 [ Group="第一人称获得结晶|投影制作"; SortPriority=62; ];
        VectorParameter ContactShadowColor = float4(0.008, 0.006, 0.004, 1.0) [ Group="第一人称获得结晶|阴影制作"; SortPriority=70; ];
        ScalarParameter ContactShadowBaseOffsetXUV = 0.0 [ Group="第一人称获得结晶|阴影制作"; SortPriority=71; ];
        ScalarParameter ContactShadowBaseOffsetYUV = 0.0039 [ Group="第一人称获得结晶|阴影制作"; SortPriority=72; ];
        ScalarParameter ContactShadowLiftOffsetXUV = 0.0 [ Group="第一人称获得结晶|阴影制作"; SortPriority=73; ];
        ScalarParameter ContactShadowLiftOffsetYUV = 0.0100 [ Group="第一人称获得结晶|阴影制作"; SortPriority=74; ];
        ScalarParameter ContactShadowBaseSoftnessUV = 0.0025 [ Group="第一人称获得结晶|阴影制作"; SortPriority=75; ];
        ScalarParameter ContactShadowLiftSoftnessUV = 0.0065 [ Group="第一人称获得结晶|阴影制作"; SortPriority=76; ];
        ScalarParameter ContactShadowBaseOpacity = 0.22 [ Group="第一人称获得结晶|阴影制作"; SortPriority=77; ];
        ScalarParameter ContactShadowLiftOpacity = 0.09 [ Group="第一人称获得结晶|阴影制作"; SortPriority=78; ];
        ScalarParameter ContactShadowAlphaThreshold = 0.18 [ Group="第一人称获得结晶|阴影制作"; SortPriority=79; ];
        ScalarParameter ContactShadowAlphaFeather = 0.12 [ Group="第一人称获得结晶|阴影制作"; SortPriority=80; ];
    }

    Settings = { Domain = "UI"; ShadingModel = "Unlit"; BlendMode = "PremultipliedAlpha"; TwoSided = true; }
    Outputs = { float3 Color; float Alpha; Base.EmissiveColor = Color; Base.Opacity = Alpha; }

    Graph = {
        float2 uv = UE.TexCoord(Index=0);
        float3 projectedUVAndMask;
        WacomFirstPersonCard_ProjectSurface(uv, TiltX, TiltY, PerspectiveStrength, ReferenceTiltDegrees, ForeshortenStrength, EdgeFadeUV, projectedUVAndMask);
        float2 projectedUV = UE.Expression(Class="ComponentMask", OutputType="float2", Input=projectedUVAndMask, R=true, G=true, B=false, A=false);
        float insideMask = UE.Expression(Class="ComponentMask", OutputType="float1", Input=projectedUVAndMask, R=false, G=false, B=true, A=false);
        float2 surfaceInvSize = UE.Expression(Class="ComponentMask", OutputType="float2", Input=SurfaceInvSize, R=true, G=true, B=false, A=false);
        float4 surface = Texture(Coordinates=projectedUV);
        float3 surfaceColor = UE.Expression(Class="ComponentMask", OutputType="float3", Input=surface, R=true, G=true, B=true, A=false);
        float surfaceAlpha = UE.Expression(Class="ComponentMask", OutputType="float1", Input=surface, R=false, G=false, B=false, A=true);

        float assembledVisibility;
        float stableCellHash;
        WacomFirstPersonCard_ComputeGainRevealVisibility(projectedUV, surfaceInvSize, GainRevealProgress, GainRevealSeedEstablishEnd, GainRevealAssemblyEnd, GainRevealReducedMotion, GainRevealReducedCrossFadeStart, GainRevealReducedCrossFadeEnd, GainRevealPixelColumns, GainRevealSeed, assembledVisibility, stableCellHash);
        float2 crystalSourceUV;
        float crystalClusterMask;
        float rarityEdgePulse;
        WacomFirstPersonCard_ComputeGainRevealCrystal(projectedUV, surfaceInvSize, GainRevealProgress, GainRevealSeedEstablishEnd, GainRevealAssemblyEnd, GainRevealRarityEdgePeak, GainRevealSettleEnd, GainRevealReducedMotion, GainRevealPixelColumns, GainRevealClusterDensity, GainRevealClusterTravelPixels, GainRevealSeed, crystalSourceUV, crystalClusterMask, rarityEdgePulse);
        float4 crystalSource = Texture(Coordinates=crystalSourceUV);
        float3 crystalSourceColor = UE.Expression(Class="ComponentMask", OutputType="float3", Input=crystalSource, R=true, G=true, B=true, A=false);
        float crystalSourceAlpha = UE.Expression(Class="ComponentMask", OutputType="float1", Input=crystalSource, R=false, G=false, B=false, A=true);

        float2 edgeX = float2(surfaceInvSize.x * 2.0, 0.0);
        float2 edgeY = float2(0.0, surfaceInvSize.y * 2.0);
        float4 edgeL = Texture(Coordinates=projectedUV-edgeX); float4 edgeR = Texture(Coordinates=projectedUV+edgeX);
        float4 edgeT = Texture(Coordinates=projectedUV-edgeY); float4 edgeB = Texture(Coordinates=projectedUV+edgeY);
        float edgeLA = UE.Expression(Class="ComponentMask", OutputType="float1", Input=edgeL, R=false,G=false,B=false,A=true);
        float edgeRA = UE.Expression(Class="ComponentMask", OutputType="float1", Input=edgeR, R=false,G=false,B=false,A=true);
        float edgeTA = UE.Expression(Class="ComponentMask", OutputType="float1", Input=edgeT, R=false,G=false,B=false,A=true);
        float edgeBA = UE.Expression(Class="ComponentMask", OutputType="float1", Input=edgeB, R=false,G=false,B=false,A=true);
        float sourceEdge;
        WacomFirstPersonCard_ComputeGainRevealSourceEdge(surfaceAlpha, edgeLA, edgeRA, edgeTA, edgeBA, sourceEdge);

        float3 crystalPrimary = UE.Expression(Class="ComponentMask", OutputType="float3", Input=GainRevealCrystalPrimaryColor, R=true,G=true,B=true,A=false);
        float3 crystalSecondary = UE.Expression(Class="ComponentMask", OutputType="float3", Input=GainRevealCrystalSecondaryColor, R=true,G=true,B=true,A=false);
        float3 crystalColor;
        WacomFirstPersonCard_SelectGainRevealCrystalColor(stableCellHash, crystalPrimary, crystalSecondary, crystalSourceColor, crystalColor);
        float crystalAlpha = crystalSourceAlpha * crystalClusterMask * insideMask * saturate(GainRevealEnabled);

        float3 neutralEdge = UE.Expression(Class="ComponentMask", OutputType="float3", Input=GainRevealNeutralEdgeColor, R=true,G=true,B=true,A=false);
        float3 whiteEdge = UE.Expression(Class="ComponentMask", OutputType="float3", Input=GainRevealWhiteEdgeColor, R=true,G=true,B=true,A=false);
        float3 blueEdge = UE.Expression(Class="ComponentMask", OutputType="float3", Input=GainRevealBlueEdgeColor, R=true,G=true,B=true,A=false);
        float3 yellowEdge = UE.Expression(Class="ComponentMask", OutputType="float3", Input=GainRevealYellowEdgeColor, R=true,G=true,B=true,A=false);
        float3 purpleEdge = UE.Expression(Class="ComponentMask", OutputType="float3", Input=GainRevealPurpleEdgeColor, R=true,G=true,B=true,A=false);
        float3 rarityColor;
        WacomFirstPersonCard_SelectGainRevealRarityColor(GainRevealRarityIndex, neutralEdge, whiteEdge, blueEdge, yellowEdge, purpleEdge, rarityColor);

        float enabled = saturate(GainRevealEnabled);
        float cardVisibility = lerp(1.0, assembledVisibility, enabled);
        float cardAlpha = surfaceAlpha * cardVisibility * insideMask;
        float3 cardColor = surfaceColor * cardVisibility * insideMask;
        float rarityAlpha = sourceEdge * rarityEdgePulse * enabled * insideMask;

        float safeLift = clamp(ContactShadowLift, 0.0, 1.0);
        float2 shadowOffset;
        WacomFirstPersonCard_ResolveContactShadowOffset(safeLift, ContactShadowBaseOffsetXUV, ContactShadowBaseOffsetYUV, ContactShadowLiftOffsetXUV, ContactShadowLiftOffsetYUV, ContactShadowTiltOffsetXUV, ContactShadowTiltOffsetYUV, shadowOffset);
        float shadowSoftness = lerp(ContactShadowBaseSoftnessUV, ContactShadowLiftSoftnessUV, safeLift);
        float2 shadowUV = projectedUV - shadowOffset;
        float2 sx = float2(shadowSoftness, 0.0); float2 sy = float2(0.0, shadowSoftness);
        float4 c0 = Texture(Coordinates=shadowUV); float4 c1 = Texture(Coordinates=shadowUV-sx); float4 c2 = Texture(Coordinates=shadowUV+sx);
        float4 c3 = Texture(Coordinates=shadowUV-sy); float4 c4 = Texture(Coordinates=shadowUV+sy); float4 c5 = Texture(Coordinates=shadowUV-sx-sy);
        float4 c6 = Texture(Coordinates=shadowUV+sx-sy); float4 c7 = Texture(Coordinates=shadowUV-sx+sy); float4 c8 = Texture(Coordinates=shadowUV+sx+sy);
        float a0 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c0, R=false,G=false,B=false,A=true);
        float a1 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c1, R=false,G=false,B=false,A=true);
        float a2 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c2, R=false,G=false,B=false,A=true);
        float a3 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c3, R=false,G=false,B=false,A=true);
        float a4 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c4, R=false,G=false,B=false,A=true);
        float a5 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c5, R=false,G=false,B=false,A=true);
        float a6 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c6, R=false,G=false,B=false,A=true);
        float a7 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c7, R=false,G=false,B=false,A=true);
        float a8 = UE.Expression(Class="ComponentMask", OutputType="float1", Input=c8, R=false,G=false,B=false,A=true);
        float shadowMask;
        WacomFirstPersonCard_CombineContactShadowAlpha(a0,a1,a2,a3,a4,a5,a6,a7,a8,ContactShadowAlphaThreshold,ContactShadowAlphaFeather,shadowMask);
        float shadowVisibility; float shadowHash;
        WacomFirstPersonCard_ComputeGainRevealVisibility(shadowUV, surfaceInvSize, GainRevealProgress, GainRevealSeedEstablishEnd, GainRevealAssemblyEnd, GainRevealReducedMotion, GainRevealReducedCrossFadeStart, GainRevealReducedCrossFadeEnd, GainRevealPixelColumns, GainRevealSeed, shadowVisibility, shadowHash);
        float3 shadowColor = UE.Expression(Class="ComponentMask", OutputType="float3", Input=ContactShadowColor, R=true,G=true,B=true,A=false);
        float shadowOpacity = lerp(ContactShadowBaseOpacity, ContactShadowLiftOpacity, safeLift) * max(ContactShadowOpacityMultiplier, 0.0);
        float shadowAlpha = shadowMask * lerp(1.0, shadowVisibility, enabled) * shadowOpacity * clamp(ContactShadowEnabled,0.0,1.0) * insideMask * (1.0-cardAlpha-crystalAlpha);

        Color = cardColor + crystalColor * crystalAlpha * max(GainRevealCrystalBrightness, 0.0) + rarityColor * rarityAlpha * max(GainRevealEdgeBrightness, 0.0) + shadowColor * shadowAlpha;
        Alpha = saturate(cardAlpha + crystalAlpha + rarityAlpha + shadowAlpha);
    }
}
