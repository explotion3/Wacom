// Step 2: Card with background layer + frame layer (alpha blended)
// Layer order (bottom to top):
//   1. Background paper (Card_Base_Paper)
//   2. Outer frame (Card_OuterFrame)

import "Shared/CardCommon.dsh";

Shader(Name="DreamMaterials/M_Card_Step2")
{
    Properties = {
        // --- Background layer ---
        VectorParameter BGUVScale = float4(1.0, 1.0, 0.0, 0.0) [
            Group="01 - Background UV";
            SortPriority=0;
            Description="Background texture scale. Smaller = texture appears larger.";
        ];

        VectorParameter BGUVOffset = float4(0.0, 0.0, 0.0, 0.0) [
            Group="01 - Background UV";
            SortPriority=5;
            Description="Background texture offset.";
        ];

        // --- Frame layer ---
        VectorParameter FrameUVScale = float4(1.0, 1.0, 0.0, 0.0) [
            Group="02 - Frame UV";
            SortPriority=10;
            Description="Frame texture scale.";
        ];

        VectorParameter FrameUVOffset = float4(0.0, 0.0, 0.0, 0.0) [
            Group="02 - Frame UV";
            SortPriority=15;
            Description="Frame texture offset.";
        ];

        // --- Surface ---
        ScalarParameter Roughness = 0.7 [
            Group="03 - Surface";
            SortPriority=20;
            Description="Surface roughness. 0=mirror, 1=fully matte.";
        ];
    }

    Settings = {
        Domain = "Surface";
        ShadingModel = "DefaultLit";
        BlendMode = "Masked";
        TwoSided = true;
        OpacityMaskClipValue = 0.3333;
    }

    Outputs = {
        float3 Color;
        float Rough;
        float Mask;
        Base.BaseColor = Color;
        Base.Roughness = Rough;
        Base.OpacityMask = Mask;
    }

    Graph = {
        float2 uv = UE.TexCoord(Index=0);

        // --- Background layer ---
        float2 bgUV;
        Card_TransformUV(uv, BGUVScale, BGUVOffset, bgUV);

        float4 bg = UE.Expression(
            Class="TextureSampleParameter2D",
            OutputType="float4",
            ParameterName="BackgroundTexture",
            Group="01 - Background",
            SortPriority=1,
            Texture=Path(Game, "Asset/card/Card_Base_Paper_512x768"),
            Coordinates=bgUV);

        // --- Frame layer ---
        float2 frameUV;
        Card_TransformUV(uv, FrameUVScale, FrameUVOffset, frameUV);

        float4 frame = UE.Expression(
            Class="TextureSampleParameter2D",
            OutputType="float4",
            ParameterName="FrameTexture",
            Group="02 - Frame",
            SortPriority=11,
            Texture=Path(Game, "Asset/card/Card_OuterFrame_512x768"),
            Coordinates=frameUV);

        // --- Composite (frame over background) ---
        float3 composedColor;
        float composedAlpha;
        Card_AlphaOver(bg, frame, composedColor, composedAlpha);

        Color = composedColor;
        Rough = Roughness;
        Mask = composedAlpha;
    }
}
