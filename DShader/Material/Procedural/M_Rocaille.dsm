import "Shared/Rocaille.dsh";

Shader(Name="DreamMaterials/M_Rocaille")
{
    Properties = {
        VectorParameter Resolution = float4(1920.0, 1080.0, 0.0, 0.0) [
            Group="Rocaille";
            SortPriority=0;
            Description="Viewport resolution for aspect ratio.";
        ];

        ScalarParameter TimeScale = 1.0 [
            Group="Animation";
            SortPriority=5;
            Description="Global time multiplier.";
        ];

        ScalarParameter AnimSpeed = 1.0 [
            Group="Animation";
            SortPriority=10;
            Description="Turbulence animation speed. Try 0.3~2.0.";
        ];

        ScalarParameter Zoom = 0.3 [
            Group="View";
            SortPriority=15;
            Description="Zoom level. Lower=more zoomed in. Try 0.1~1.0.";
        ];

        ScalarParameter Layers = 9.0 [
            Group="Turbulence";
            SortPriority=20;
            Description="Number of color layers (integer). More=richer. 3~9.";
        ];

        ScalarParameter TurbulenceSteps = 9.0 [
            Group="Turbulence";
            SortPriority=25;
            Description="Turbulence iterations per layer (integer). More=finer detail. 4~9.";
        ];

        ScalarParameter TurbulenceStrength = 1.0 [
            Group="Turbulence";
            SortPriority=30;
            Description="Turbulence distortion strength. Try 0.5~2.0.";
        ];

        ScalarParameter ColorBrightness = 1.0 [
            Group="Color";
            SortPriority=35;
            Description="Color accumulation brightness. Try 0.5~3.0.";
        ];

        ScalarParameter FinalBrightness = 1.0 [
            Group="Color";
            SortPriority=40;
            Description="Final output brightness multiplier.";
        ];
    }

    Settings = {
        Domain = "UI";
        ShadingModel = "Unlit";
    }

    Outputs = {
        float3 Color;
        Base.EmissiveColor = Color;
        Base.Opacity = 1.0;
    }

    Graph = {
        float2 uv = UE.TexCoord(Index=0);
        float time = UE.Time() * TimeScale;

        float3 rocColor;
        Rocaille_Evaluate(uv, Resolution, time, Zoom, Layers, TurbulenceSteps, TurbulenceStrength, ColorBrightness, AnimSpeed, rocColor);

        Color = rocColor * FinalBrightness;
    }
}
