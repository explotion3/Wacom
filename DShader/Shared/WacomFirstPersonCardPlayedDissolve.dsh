Function SelfContained WacomFirstPersonCard_QuantizeDissolveUV(
    in float2 surfaceUV,
    in float gridColumns,
    in float2 surfaceInvSize,
    out float2 pixelCell,
    out float2 pixelUV)
{
    float safeColumns = max(gridColumns, 1.0);
    float safeInvWidth = max(surfaceInvSize.x, 0.000001);
    float safeInvHeight = max(surfaceInvSize.y, 0.000001);
    float gridRows = max(safeColumns * safeInvWidth / safeInvHeight, 1.0);
    float2 gridSize = float2(safeColumns, gridRows);
    pixelCell = floor(surfaceUV * gridSize);
    pixelUV = (pixelCell + float2(0.5, 0.5)) / gridSize;
}

Function SelfContained WacomFirstPersonCard_ComputeDissolveMasks(
    in float2 pixelUV,
    in float noiseValue,
    in float amount,
    in float directionAngleDegrees,
    in float jitter,
    in float edgeWidth,
    in float ashTrailWidth,
    in float reducedMotion,
    out float visibleMask,
    out float edgeMask,
    out float ashTrailMask)
{
    float safeAmount = saturate(amount);
    float angleRadians = directionAngleDegrees * 0.01745329252;
    float2 direction = float2(cos(angleRadians), sin(angleRadians));
    float directionalPosition = saturate(
        dot(pixelUV - float2(0.5, 0.5), direction) * 0.70710678 + 0.5);
    float safeJitter = max(jitter, 0.0);
    float dissolveThreshold = lerp(
        -safeJitter * 0.5 - 0.001,
        1.0 + safeJitter * 0.5 + 0.001,
        safeAmount);
    float field = directionalPosition
        + (saturate(noiseValue) - 0.5) * safeJitter
        - dissolveThreshold;

    float directionalVisible = step(0.0, field);
    float safeEdgeWidth = max(edgeWidth, 0.0001);
    float progressActive = step(0.0001, safeAmount) * (1.0 - step(0.9999, safeAmount));
    float directionalEdge = directionalVisible * (1.0 - step(safeEdgeWidth, field)) * progressActive;
    float safeTrailWidth = max(ashTrailWidth, 0.0001);
    float directionalTrail = step(-safeTrailWidth, field) * (1.0 - step(0.0, field)) * progressActive;
    float useReducedMotion = step(0.5, reducedMotion);

    visibleMask = lerp(directionalVisible, 1.0 - safeAmount, useReducedMotion);
    edgeMask = directionalEdge * (1.0 - useReducedMotion);
    ashTrailMask = directionalTrail * (1.0 - useReducedMotion);
}

Function SelfContained WacomFirstPersonCard_ComputeAshSpawn(
    in float2 pixelCell,
    in float noiseValue,
    in float seed,
    in float density,
    out float ashSpawn,
    out float ashDriftSign,
    out float accentMask)
{
    float randomValue = frac(
        sin(dot(pixelCell + seed * 131.0, float2(37.719, 19.913)))
        * 43758.5453);
    ashSpawn = step(1.0 - saturate(density), randomValue * 0.55 + saturate(noiseValue) * 0.45);
    ashDriftSign = randomValue * 2.0 - 1.0;
    accentMask = step(0.82, frac(randomValue + saturate(noiseValue) * 0.73));
}
