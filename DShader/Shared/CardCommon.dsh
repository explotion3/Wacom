// CardCommon - shared helpers for physical card materials

// UV transform: center-based scale + offset
// Accepts full float4 parameters (VectorParameter) and does .xy swizzle internally.
// This keeps the generated material graph clean - no extra Append/Mask nodes.
// final_uv = (uv - 0.5) / scale.xy + 0.5 + offset.xy
Function Card_TransformUV(
    in float2 uv,
    in float4 scale,
    in float4 offset,
    out float2 result)
{
    float2 s = max(scale.xy, float2(0.0001, 0.0001));
    float2 centered = uv - float2(0.5, 0.5);
    float2 scaled = centered / s;
    result = scaled + float2(0.5, 0.5) + offset.xy;
}

// Classic "over" alpha compositing: top over bottom
// Split into two separate single-output functions to avoid DreamShader
// multi-output function signature bug.

// out_color = bottom * (1 - top_a) + top_rgb * top_a
Function Card_AlphaOverColor(
    in float4 bottom,
    in float4 top,
    out float3 result)
{
    float oneMinusTopA = 1.0 - top.a;
    result = bottom.rgb * oneMinusTopA + top.rgb * top.a;
}

// out_alpha = bottom_a + top_a * (1 - bottom_a)
Function Card_AlphaOverMask(
    in float4 bottom,
    in float4 top,
    out float result)
{
    result = bottom.a + top.a * (1.0 - bottom.a);
}
