Function SelfContained WacomFirstPersonCard_ComputePileTransferGlyph(
    in float2 uv,
    in float pixelColumns,
    in float borderWidth,
    in float centerMarkSize,
    in float4 outlineColor,
    in float4 fillColor,
    in float4 centerColor,
    in float glowStrength,
    out float3 glyphColor,
    out float glyphAlpha)
{
    float safeColumns = max(pixelColumns, 4.0);
    float2 grid = float2(safeColumns, safeColumns * 1.57142857);
    float2 pixelUV = (floor(saturate(uv) * grid) + float2(0.5, 0.5)) / grid;
    float2 edgeDistance = min(pixelUV, 1.0 - pixelUV);
    float cornerCut = step(1.5 / safeColumns, edgeDistance.x + edgeDistance.y);
    float body = step(0.5 / safeColumns, edgeDistance.x)
        * step(0.5 / (safeColumns * 1.57142857), edgeDistance.y)
        * cornerCut;
    float safeBorder = max(borderWidth, 0.5 / safeColumns);
    float inner = step(safeBorder, edgeDistance.x)
        * step(safeBorder * 0.63636364, edgeDistance.y)
        * step(safeBorder * 1.6, edgeDistance.x + edgeDistance.y);
    float border = saturate(body - inner);

    float2 centered = abs(pixelUV - float2(0.5, 0.5));
    float diamondDistance = centered.x + centered.y;
    float markOuter = 1.0 - step(max(centerMarkSize, 0.05), diamondDistance);
    float markInner = 1.0 - step(max(centerMarkSize * 0.45, 0.02), diamondDistance);
    float markRing = saturate(markOuter - markInner);
    float diagonal = step(abs(centered.x - centered.y), 0.75 / safeColumns)
        * step(diamondDistance, 0.34);
    float mark = saturate(markRing + markInner * 0.65 + diagonal * 0.35) * inner;

    float3 baseColor = lerp(fillColor.rgb, outlineColor.rgb, border);
    baseColor = lerp(baseColor, centerColor.rgb, mark);
    float glow = 1.0 + max(glowStrength, 0.0) * (border + mark) * 0.35;
    glyphAlpha = body * max(max(outlineColor.a, fillColor.a), centerColor.a);
    glyphColor = baseColor * glow * glyphAlpha;
}

Function SelfContained WacomFirstPersonCard_ComputePileTransferVisual(
    in float2 uv,
    in float2 shapeData,
    in float pixelColumns,
    in float borderWidth,
    in float centerMarkSize,
    in float4 outlineColor,
    in float4 fillColor,
    in float4 centerColor,
    in float glowStrength,
    in float4 trailPrimaryColor,
    in float4 trailSecondaryColor,
    in float4 trailAccentColor,
    in float trailPrimaryWeight,
    in float trailSecondaryWeight,
    in float trailAccentWeight,
    in float trailPixelColumns,
    in float trailPixelRows,
    in float trailHeadPixelRetention,
    in float trailTailPixelRetention,
    in float trailGlowStrength,
    in float4 motePrimaryColor,
    in float4 moteAccentColor,
    in float moteGlowStrength,
    in float4 impactPrimaryColor,
    in float4 impactAccentColor,
    in float impactGlowStrength,
    out float3 visualColor,
    out float visualAlpha)
{
    float3 glyphColor;
    float glyphAlpha;
    WacomFirstPersonCard_ComputePileTransferGlyph(
        uv,
        pixelColumns,
        borderWidth,
        centerMarkSize,
        outlineColor,
        fillColor,
        centerColor,
        glowStrength,
        glyphColor,
        glyphAlpha);

    float shapeKind = shapeData.x;
    float isMain = 1.0 - step(0.5, shapeKind);
    float isTrail = step(0.5, shapeKind) * (1.0 - step(1.5, shapeKind));
    float isMote = step(1.5, shapeKind) * (1.0 - step(2.5, shapeKind));
    float isImpact = step(2.5, shapeKind);
    float variant = step(1.5, shapeData.y);
    float shapeAge = saturate(shapeData.y - variant * 2.0);

    float2 safeTrailGrid = float2(max(trailPixelColumns, 1.0), max(trailPixelRows, 1.0));
    float2 trailCell = floor(saturate(uv) * safeTrailGrid);
    float2 trailBit0 = fmod(trailCell, 2.0);
    float trailIndex2 = trailBit0.x * 2.0 + trailBit0.y * 3.0
        - trailBit0.x * trailBit0.y * 4.0;
    float2 trailBit1 = fmod(floor(trailCell / 2.0), 2.0);
    float trailIndex4 = trailBit1.x * 2.0 + trailBit1.y * 3.0
        - trailBit1.x * trailBit1.y * 4.0 + trailIndex2 * 4.0;
    float trailThreshold = (trailIndex4 + 0.5) / 16.0;
    float trailRetention = saturate(lerp(
        trailHeadPixelRetention,
        trailTailPixelRetention,
        shapeAge));
    float trailMask = step(trailThreshold, trailRetention);

    float3 trailWeights = max(
        float3(trailPrimaryWeight, trailSecondaryWeight, trailAccentWeight),
        float3(0.0, 0.0, 0.0));
    float trailWeightSum = max(trailWeights.x + trailWeights.y + trailWeights.z, 0.0001);
    trailWeights /= trailWeightSum;
    float trailPaletteValue = frac(
        trailCell.x * 0.754877666
        + trailCell.y * 0.569840296
        + variant * 0.438289);
    float4 trailColor = lerp(
        trailPrimaryColor,
        trailSecondaryColor,
        step(trailWeights.x, trailPaletteValue));
    trailColor = lerp(
        trailColor,
        trailAccentColor,
        step(trailWeights.x + trailWeights.y, trailPaletteValue));
    float trailAlpha = trailMask * trailColor.a;
    float trailGlow = 1.0 + max(trailGlowStrength, 0.0) * (1.0 - shapeAge) * 0.35;
    float3 trailPremultiplied = trailColor.rgb * trailGlow * trailAlpha;

    float2 moteCentered = abs(uv - float2(0.5, 0.5));
    float moteBody = step(max(moteCentered.x, moteCentered.y), 0.46);
    float4 moteColor = lerp(motePrimaryColor, moteAccentColor, variant);
    float moteAlpha = moteBody * moteColor.a;
    float moteGlow = 1.0 + max(moteGlowStrength, 0.0) * (1.0 - shapeAge) * 0.35;
    float3 motePremultiplied = moteColor.rgb * moteGlow * moteAlpha;

    float2 impactGrid = floor(saturate(uv) * float2(12.0, 12.0)) / 12.0;
    float2 impactCentered = abs(impactGrid - float2(0.5, 0.5));
    float impactDistance = max(impactCentered.x, impactCentered.y);
    float impactOuter = 1.0 - step(0.48, impactDistance);
    float impactInner = 1.0 - step(lerp(0.24, 0.42, shapeAge), impactDistance);
    float impactRing = saturate(impactOuter - impactInner);
    float4 impactColor = lerp(impactPrimaryColor, impactAccentColor, variant);
    float impactAlpha = impactRing * impactColor.a;
    float impactGlow = 1.0 + max(impactGlowStrength, 0.0) * (1.0 - shapeAge) * 0.5;
    float3 impactPremultiplied = impactColor.rgb * impactGlow * impactAlpha;

    visualColor = glyphColor * isMain
        + trailPremultiplied * isTrail
        + motePremultiplied * isMote
        + impactPremultiplied * isImpact;
    visualAlpha = glyphAlpha * isMain
        + trailAlpha * isTrail
        + moteAlpha * isMote
        + impactAlpha * isImpact;
}
