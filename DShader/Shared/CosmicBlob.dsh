// Cosmic Blob - code golf style iterative distortion shader
// Adapted for DreamShaderLang

Function CosmicBlob_Evaluate(
    in float2 fragUV,
    in float4 resParam,
    in float time,
    in float zoom,
    in float iterations,
    in float distortSpeed,
    in float warpStrength,
    in float tanhStrength,
    in float driftAmount,
    in float pulseAmount,
    in float colorContrast,
    out float3 color)
{
    float2 resolution = resParam.xy;

    // Centered and scaled coordinates
    float2 u = (fragUV * 2.0 - 1.0);
    u.x *= resolution.x / max(resolution.y, 0.0001);
    u *= zoom;

    float4 z = float4(1.0, 2.0, 3.0, 0.0);
    float4 o = z;

    float2 v = float2(0.0, 0.0);
    float a = 0.5;
    float t = time;

    int maxIter = (int)iterations;

    for (int iter = 0; iter < 19; iter++)
    {
        if (iter >= maxIter) break;
        float i = (float)(iter + 1);

        // v = cos(++t - 7*u*pow(a, i)) - 5*u
        t += 1.0;
        float ai = pow(a, i);
        v = cos(t - 7.0 * u * ai) - 5.0 * u;

        // u distortion with mat2 rotation
        // mat2(cos(i + 0.02*t - z.wxzw*11))
        // z.wxzw = (0, 1, 3, 0) * 11 -> offsets for rotation matrix
        float rotBase = i + 0.02 * t * distortSpeed;
        float r00 = cos(rotBase - 0.0);   // z.w * 11 = 0
        float r01 = cos(rotBase - 11.0);  // z.x * 11 = 11
        float r10 = cos(rotBase - 33.0);  // z.z * 11 = 33
        float r11 = cos(rotBase - 0.0);   // z.w * 11 = 0

        // u *= mat2(...)
        float ux = u.x * r00 + u.y * r01;
        float uy = u.x * r10 + u.y * r11;
        u = float2(ux, uy);

        // tanh(40 * dot(u,u) * cos(100*u.yx + t)) / 200
        float ud = dot(u, u);
        float2 tanhInput = tanhStrength * ud * cos(100.0 * float2(u.y, u.x) + t);
        float2 tanhVal = float2(tanh(tanhInput.x), tanh(tanhInput.y));
        u += tanhVal / 200.0;

        // + 0.2 * a * u (drift)
        a += 0.03;
        u += driftAmount * a * u;

        // + cos(4/exp(dot(o,o)/100) + t) / 300 (pulse)
        float pulse = cos(4.0 / exp(dot(o, o) / 100.0) + t);
        u += pulseAmount * pulse / 300.0;

        // o += (1 + cos(z + t)) / length((1 + i*dot(v,v)) * sin(1.5*u/(0.5-dot(u,u)) - 9*u.yx + t))
        float vd = dot(v, v);
        float denom_scale = 1.0 + i * vd;
        float udot = dot(u, u);
        float2 sinInput = 1.5 * u / max(0.5 - udot, 0.001) - 9.0 * float2(u.y, u.x) + t;
        float2 sinVal = sin(sinInput) * denom_scale;
        float len = length(sinVal);
        float4 contrib = (1.0 + cos(z + t)) / max(len, 0.001);
        o += contrib * warpStrength;
    }

    // Final color: 25.6 / (min(o, 13) + 164/o) - dot(u,u)/250
    float4 oMin = min(o, 13.0);
    float4 oSafe = max(abs(o), 0.001) * sign(o + 0.001);
    float4 finalO = 25.6 / (oMin + 164.0 / oSafe) - dot(u, u) / (250.0 / colorContrast);

    color = float3(
        saturate(finalO.x),
        saturate(finalO.y),
        saturate(finalO.z)
    );
}
